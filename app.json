{
  "expo": {
    "icon": "https://agent.expo.dev/static/icon.png",
    "orientation": "default",
    "scheme": "acme",
    "userInterfaceStyle": "automatic",
    "web": {
      "output": "server"
    },
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "experiments": {
      "reactCompiler": true
    },
    "plugins": [
      "expo-font",
      "expo-image",
      "expo-router",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "18.5"
          },
          "android": {
            "minSdkVersion": 28,
            "compileSdkVersion": 35,
            "targetSdkVersion": 35
          }
        }
      ],
      "@bacons/apple-colors"
    ],
    "name": "Local Pizza",
    "owner": "jonsamp",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "927f8541-4e72-4171-b60d-dcd368c9446e"
      }
    },
    "ios": {
      "bundleIdentifier": "com.dannymanning.local-pizza"
    }
  }
}
