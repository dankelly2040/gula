{
  "expo": {
    "name": "Local Pizza",
    "slug": "gula",
    "scheme": "gula",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "com.dannymanning.gula",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "https://agent.expo.dev/static/icon.png",
        "backgroundColor": "#1a1a2e"
      },
      "package": "com.dannymanning.gula",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA"
      ]
    },
    "experiments": {
      "reactCompiler": true,
      "inlineModules": {
        "watchedDirectories": [
          "src/native"
        ]
      }
    },
    "plugins": [
      "expo-font",
      "expo-image",
      "expo-router",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "18.5"
          },
          "android": {
            "minSdkVersion": 28,
            "compileSdkVersion": 35,
            "targetSdkVersion": 35
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Local Pizza to access your photos to add pizza pics to your logs.",
          "cameraPermission": "Allow Local Pizza to use your camera to snap your slice."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Local Pizza to use your location to find pizza spots near you."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Local Pizza to use your camera to snap your slice."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF1B2"
        }
      ],
      "expo-notifications",
      "@bacons/apple-colors",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-maps"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "215878b4-2091-4ccb-8a6f-6545863486f0"
      }
    },
    "owner": "dannymanning",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/215878b4-2091-4ccb-8a6f-6545863486f0"
    }
  }
}
